# ==============================================================================
# CSA BOOKS 4 KIDS - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Istruzioni:
# 1. Copia questo file in .env:
#    cp .env.example .env
# 2. Nelle impostazioni del progetto su Vercel (Project Settings > Environment Variables):
#    Aggiungi le seguenti variabili:
# ==============================================================================

# Chiave API Brevo (Sendinblue) v3 obbligatoria per tutti gli invii email
# Reperibile su https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here

# Configurazione Mittente Otto - La chiave segreta («Einstein, questa te la sei persa!»)
# Indirizzo mittente autorizzato in Brevo (default: otto@csabookskids.com)
OTTO_SENDER_EMAIL=otto@csabookskids.com

# Nome visualizzato dal client di posta del destinatario
OTTO_SENDER_NAME=Otto | Il mondo delle scoperte

# Indirizzo email dove ricevere le risposte dei genitori (Reply-To)
OTTO_REPLY_TO=csabooks.kids@gmail.com

# Indirizzo di notifica amministratore per copia conoscenza (lascia vuoto per disattivare)
OTTO_ADMIN_CC=csabooks.kids@gmail.com

# Mittente verificato di emergenza/fallback se otto@csabookskids.com non è ancora abilitato
BREVO_FALLBACK_SENDER=csabooks.kids@gmail.com

# ID lista contatti Brevo per chi spunta il consenso marketing (opzionale)
# Reperibile nel pannello Brevo > Contatti > Liste (es. 3)
BREVO_MARKETING_LIST_ID=
